
features/ModuleEmbedding:
    name = "conv_embedding"
    module = @ad.test.ConvEmbedding()
    method = "get_embedding"
    transforms = [
        @ad.transforms.Gain, 
        @ad.transforms.PitchShift
    ]
    sr = %SAMPLE_RATE
    retain_module = True

parse_features:
    features = [@features/ad.features.ModuleEmbedding]
    device = %DEVICE

